# Copy this file to a project's root as .dev-exec.env.
# Replace every placeholder locally and do not commit the resulting file.

DEV_EXEC_HOST=dev-machine
DEV_EXEC_DIR=/absolute/path/to/project

# Optional: defaults to /bin/sh.
# DEV_EXEC_SHELL=/bin/zsh

# Recommended for separate checkouts: flush and health-check this Mutagen
# session before every remote command. Create it with setup-mutagen.sh, or use
# the exact name of an existing session where dev-exec runs.
# DEV_EXEC_MUTAGEN_SESSION=project-sync
# DEV_EXEC_MUTAGEN_BIN=mutagen

# Optional alternative: keep the Mutagen daemon/session on a separate control
# environment and run its preflight through an SSH alias reachable here.
# Set this together with DEV_EXEC_MUTAGEN_SESSION; leave it unset when the
# Mutagen CLI runs in the same environment as dev-exec.
# DEV_EXEC_MUTAGEN_HOST=sync-control

# After configuring, run `dev-exec doctor`. Without a synchronization
# preflight it will require an independent shared-checkout/freshness check.
