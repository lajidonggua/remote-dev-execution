# Copy to ~/.config/remote-dev-execution/relay.env on the Mac.
# Keep this file local and use an SSH alias already trusted by the Mac.

DEV_RELAY_VM_HOST=dev-vm
DEV_RELAY_LOCAL_PORT=22022
DEV_RELAY_REMOTE_PORT=22022
DEV_RELAY_VM_ALIAS=rde-mac-dev

# Optional: expose same-numbered Mac debug ports on VM loopback.
# DEV_RELAY_DEBUG_PORTS="3000 5005 9229"

# Optional overrides.
# DEV_RELAY_STATE_DIR="$HOME/.local/state/remote-dev-execution/relay"
# DEV_RELAY_RUNTIME_DIR="${TMPDIR%/}/rde-$(id -u)"
# DEV_RELAY_SSH_BIN=/usr/bin/ssh
# DEV_RELAY_SSHD_BIN=/usr/sbin/sshd
# DEV_RELAY_SSH_KEYGEN_BIN=/usr/bin/ssh-keygen
# DEV_RELAY_OUTER_SSH_CONFIG="$HOME/.ssh/config"
