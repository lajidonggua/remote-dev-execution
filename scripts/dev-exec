#!/bin/sh

set -u

usage() {
  cat <<'EOF'
Usage:
  dev-exec doctor [--verbose]
  dev-exec -- command [arg ...]
  dev-exec 'shell command with pipes or redirections'

Finds .dev-exec.env from the current directory upward, optionally flushes and
health-checks the configured Mutagen session (locally or on
DEV_EXEC_MUTAGEN_HOST), and runs the command over SSH.

The doctor command verifies configuration, synchronization preflight, and
delegated execution without disclosing infrastructure details. --verbose
shows the underlying diagnostic output.
EOF
}

fail() {
  printf 'dev-exec: %s\n' "$*" >&2
  exit 64
}

doctor_say() {
  printf 'dev-exec doctor: %s\n' "$*"
}

doctor_fail() {
  printf 'dev-exec doctor: %s\n' "$*" >&2
}

find_config() {
  search_dir=$(pwd -P 2>/dev/null) || return 1

  while :; do
    candidate=$search_dir/.dev-exec.env
    if [ -f "$candidate" ]; then
      printf '%s\n' "$candidate"
      return 0
    fi

    [ "$search_dir" = / ] && return 1
    search_dir=${search_dir%/*}
    [ -n "$search_dir" ] || search_dir=/
  done
}

shell_quote() {
  escaped=$(printf '%s_' "$1" | sed "s/'/'\\\\''/g") || return 1
  escaped=${escaped%_}
  printf "'%s'" "$escaped"
}

reject_newline() {
  value_name=$1
  value=$2
  case $value in
    *"$newline"*) fail "$value_name must not contain a newline" ;;
  esac
}

argument_mode=0
doctor_mode=0
doctor_verbose=0
case ${1-} in
  -h|--help)
    usage
    exit 0
    ;;
  doctor|--doctor)
    doctor_mode=1
    shift
    case ${1-} in
      --verbose)
        doctor_verbose=1
        shift
        ;;
    esac
    [ "$#" -eq 0 ] || {
      usage >&2
      fail 'doctor accepts only the optional --verbose flag'
    }
    ;;
  --)
    argument_mode=1
    shift
    ;;
esac

[ "$doctor_mode" -eq 1 ] || [ "$#" -gt 0 ] || {
  usage >&2
  exit 64
}

# Explicit process environment values override project defaults.
saved_host_set=0
saved_dir_set=0
saved_shell_set=0
saved_session_set=0
saved_mutagen_bin_set=0
saved_mutagen_host_set=0

if [ "${DEV_EXEC_HOST+x}" = x ]; then
  saved_host_set=1
  saved_host=$DEV_EXEC_HOST
fi
if [ "${DEV_EXEC_DIR+x}" = x ]; then
  saved_dir_set=1
  saved_dir=$DEV_EXEC_DIR
fi
if [ "${DEV_EXEC_SHELL+x}" = x ]; then
  saved_shell_set=1
  saved_shell=$DEV_EXEC_SHELL
fi
if [ "${DEV_EXEC_MUTAGEN_SESSION+x}" = x ]; then
  saved_session_set=1
  saved_session=$DEV_EXEC_MUTAGEN_SESSION
fi
if [ "${DEV_EXEC_MUTAGEN_BIN+x}" = x ]; then
  saved_mutagen_bin_set=1
  saved_mutagen_bin=$DEV_EXEC_MUTAGEN_BIN
fi
if [ "${DEV_EXEC_MUTAGEN_HOST+x}" = x ]; then
  saved_mutagen_host_set=1
  saved_mutagen_host=$DEV_EXEC_MUTAGEN_HOST
fi

config_file=$(find_config) || config_file=
if [ -n "$config_file" ]; then
  # The project config is trusted shell syntax; see references/configuration.md.
  # shellcheck disable=SC1090
  if [ "$doctor_mode" -eq 1 ] && [ "$doctor_verbose" -eq 0 ]; then
    if ! sh -n "$config_file" >/dev/null 2>&1; then
      doctor_fail 'configuration: invalid'
      exit 64
    fi
    . "$config_file" >/dev/null 2>&1
  else
    . "$config_file"
  fi
  config_status=$?
  if [ "$config_status" -ne 0 ]; then
    if [ "$doctor_mode" -eq 1 ] && [ "$doctor_verbose" -eq 0 ]; then
      doctor_fail 'configuration: invalid'
    else
      printf 'dev-exec: failed to load %s\n' "$config_file" >&2
    fi
    exit "$config_status"
  fi
fi

if [ "$saved_host_set" -eq 1 ]; then
  DEV_EXEC_HOST=$saved_host
fi
if [ "$saved_dir_set" -eq 1 ]; then
  DEV_EXEC_DIR=$saved_dir
fi
if [ "$saved_shell_set" -eq 1 ]; then
  DEV_EXEC_SHELL=$saved_shell
fi
if [ "$saved_session_set" -eq 1 ] && [ -n "$saved_session" ]; then
  DEV_EXEC_MUTAGEN_SESSION=$saved_session
fi
if [ "$saved_mutagen_bin_set" -eq 1 ]; then
  DEV_EXEC_MUTAGEN_BIN=$saved_mutagen_bin
fi
if [ "$saved_mutagen_host_set" -eq 1 ] && [ -n "$saved_mutagen_host" ]; then
  DEV_EXEC_MUTAGEN_HOST=$saved_mutagen_host
fi

mutagen_health_template='{{- range . -}}{{- if .Paused -}}paused{{- else if not .Alpha.Connected -}}disconnected{{- else if not .Beta.Connected -}}disconnected{{- else if .LastError -}}error{{- else if .Conflicts -}}conflicts{{- else if .Alpha.ScanProblems -}}problems{{- else if .Alpha.TransitionProblems -}}problems{{- else if .Beta.ScanProblems -}}problems{{- else if .Beta.TransitionProblems -}}problems{{- else -}}ok{{- end -}}{{- end -}}'
newline='
'

[ -n "${DEV_EXEC_HOST:-}" ] ||
  fail 'DEV_EXEC_HOST is required in .dev-exec.env or the process environment'
[ -n "${DEV_EXEC_DIR:-}" ] ||
  fail 'DEV_EXEC_DIR is required in .dev-exec.env or the process environment'

reject_newline DEV_EXEC_HOST "$DEV_EXEC_HOST"
reject_newline DEV_EXEC_DIR "$DEV_EXEC_DIR"
case $DEV_EXEC_DIR in
  /*) ;;
  *) fail 'DEV_EXEC_DIR must be an absolute path in the authoritative environment' ;;
esac

case $DEV_EXEC_HOST in
  -*) fail 'DEV_EXEC_HOST must not begin with a hyphen' ;;
esac

remote_shell=${DEV_EXEC_SHELL:-/bin/sh}
reject_newline DEV_EXEC_SHELL "$remote_shell"

mutagen_host=${DEV_EXEC_MUTAGEN_HOST:-}
reject_newline DEV_EXEC_MUTAGEN_HOST "$mutagen_host"
case $mutagen_host in
  -*) fail 'DEV_EXEC_MUTAGEN_HOST must not begin with a hyphen' ;;
esac
if [ -n "$mutagen_host" ] && [ -z "${DEV_EXEC_MUTAGEN_SESSION:-}" ]; then
  fail 'DEV_EXEC_MUTAGEN_HOST requires DEV_EXEC_MUTAGEN_SESSION'
fi

run_mutagen() {
  if [ -n "$mutagen_host" ]; then
    mutagen_command=
    if ! quoted_mutagen_bin=$(shell_quote "$mutagen_bin"); then
      return 64
    fi
    mutagen_command=$quoted_mutagen_bin
    for mutagen_argument do
      if ! quoted_mutagen_argument=$(shell_quote "$mutagen_argument"); then
        return 64
      fi
      mutagen_command="$mutagen_command $quoted_mutagen_argument"
    done
    ssh -T -o BatchMode=yes -o ClearAllForwardings=yes \
      -o ForwardAgent=no -o ForwardX11=no -o RequestTTY=no \
      -o StrictHostKeyChecking=yes "$mutagen_host" "$mutagen_command"
  else
    "$mutagen_bin" "$@"
  fi
}

if [ "$doctor_mode" -eq 1 ]; then
  doctor_say 'configuration: valid'
fi

if [ -n "${DEV_EXEC_MUTAGEN_SESSION:-}" ]; then
  reject_newline DEV_EXEC_MUTAGEN_SESSION "$DEV_EXEC_MUTAGEN_SESSION"
  case $DEV_EXEC_MUTAGEN_SESSION in
    -*) fail 'DEV_EXEC_MUTAGEN_SESSION must not begin with a hyphen' ;;
  esac

  mutagen_bin=${DEV_EXEC_MUTAGEN_BIN:-mutagen}
  reject_newline DEV_EXEC_MUTAGEN_BIN "$mutagen_bin"
  if [ -n "$mutagen_host" ]; then
    if [ "$doctor_mode" -eq 1 ] && [ "$doctor_verbose" -eq 1 ]; then
      run_mutagen version
    else
      run_mutagen version >/dev/null 2>&1
    fi
    mutagen_tool_status=$?
  elif command -v "$mutagen_bin" >/dev/null 2>&1; then
    mutagen_tool_status=0
  else
    mutagen_tool_status=127
  fi
  if [ "$mutagen_tool_status" -ne 0 ]; then
    if [ "$doctor_mode" -eq 1 ]; then
      doctor_fail 'synchronization tool: unavailable'
    else
      printf '%s\n' 'dev-exec: synchronization tool unavailable; remote command not started' >&2
    fi
    exit 69
  fi
  if [ "$doctor_mode" -eq 1 ]; then
    doctor_say 'synchronization tool: available'

    if [ "$doctor_verbose" -eq 1 ]; then
      run_mutagen sync list -- "$DEV_EXEC_MUTAGEN_SESSION"
    else
      run_mutagen sync list -- "$DEV_EXEC_MUTAGEN_SESSION" >/dev/null 2>&1
    fi
    session_status=$?
    if [ "$session_status" -ne 0 ]; then
      doctor_fail 'synchronization session: unavailable'
      exit "$session_status"
    fi
    doctor_say 'synchronization session: available'
  fi

  if [ "$doctor_mode" -eq 1 ] && [ "$doctor_verbose" -eq 1 ]; then
    run_mutagen sync flush -- "$DEV_EXEC_MUTAGEN_SESSION"
  else
    run_mutagen sync flush -- "$DEV_EXEC_MUTAGEN_SESSION" >/dev/null 2>&1
  fi
  sync_status=$?
  if [ "$sync_status" -ne 0 ]; then
    if [ "$doctor_mode" -eq 1 ]; then
      doctor_fail 'synchronization preflight: failed'
    else
      printf '%s\n' 'dev-exec: synchronization preflight failed; remote command not started' >&2
    fi
    exit "$sync_status"
  fi

  if [ "$doctor_mode" -eq 1 ] && [ "$doctor_verbose" -eq 1 ]; then
    sync_health=$(run_mutagen sync list --template "$mutagen_health_template" -- "$DEV_EXEC_MUTAGEN_SESSION")
  else
    sync_health=$(run_mutagen sync list --template "$mutagen_health_template" -- "$DEV_EXEC_MUTAGEN_SESSION" 2>/dev/null)
  fi
  health_status=$?
  if [ "$health_status" -ne 0 ]; then
    if [ "$doctor_mode" -eq 1 ]; then
      doctor_fail 'synchronization health: unavailable'
    else
      printf '%s\n' 'dev-exec: synchronization health check unavailable; remote command not started' >&2
    fi
    exit "$health_status"
  fi

  case $sync_health in
    ok)
      if [ "$doctor_mode" -eq 1 ]; then
        doctor_say 'synchronization health: healthy'
      fi
      ;;
    disconnected) health_message='endpoint disconnected' ;;
    conflicts) health_message='conflicts detected' ;;
    problems) health_message='filesystem problems detected' ;;
    error) health_message='session error detected' ;;
    paused) health_message='session is paused' ;;
    *) health_message='unrecognized session state' ;;
  esac
  if [ "$sync_health" != ok ]; then
    if [ "$doctor_mode" -eq 1 ]; then
      doctor_fail "synchronization health: $health_message"
    else
      printf 'dev-exec: synchronization health check failed: %s; remote command not started\n' "$health_message" >&2
    fi
    exit 65
  fi

  if [ "$doctor_mode" -eq 1 ]; then
    doctor_say 'synchronization preflight: passed'
  fi
elif [ "$doctor_mode" -eq 1 ]; then
  doctor_say 'source freshness: not verified (no synchronization preflight configured)'
fi

if [ "$doctor_mode" -eq 1 ]; then
  command_text=:
elif [ "$argument_mode" -eq 0 ] && [ "$#" -eq 1 ]; then
  command_text=$1
else
  command_text=
  for argument do
    if ! quoted_argument=$(shell_quote "$argument"); then
      fail 'failed to quote a command argument'
    fi
    if [ -n "$command_text" ]; then
      command_text="$command_text $quoted_argument"
    else
      command_text=$quoted_argument
    fi
  done
fi

if ! quoted_dir=$(shell_quote "$DEV_EXEC_DIR"); then
  fail 'failed to quote DEV_EXEC_DIR'
fi
if ! quoted_shell=$(shell_quote "$remote_shell"); then
  fail 'failed to quote DEV_EXEC_SHELL'
fi
if ! quoted_command=$(shell_quote "$command_text"); then
  fail 'failed to quote the remote command'
fi
remote_invocation="cd $quoted_dir && exec $quoted_shell -lc $quoted_command"

if [ "$doctor_mode" -eq 1 ]; then
  if [ "$doctor_verbose" -eq 1 ]; then
    ssh -T -o BatchMode=yes -o ClearAllForwardings=yes -o ForwardAgent=no \
      -o ForwardX11=no -o RequestTTY=no -o StrictHostKeyChecking=yes \
      "$DEV_EXEC_HOST" "$remote_invocation"
  else
    ssh -T -o BatchMode=yes -o ClearAllForwardings=yes -o ForwardAgent=no \
      -o ForwardX11=no -o RequestTTY=no -o StrictHostKeyChecking=yes \
      "$DEV_EXEC_HOST" "$remote_invocation" >/dev/null 2>&1
  fi
  execution_status=$?
  if [ "$execution_status" -eq 0 ]; then
    doctor_say 'authoritative execution: ready'
  else
    doctor_fail 'authoritative execution: failed'
  fi
  exit "$execution_status"
fi

ssh -T -o BatchMode=yes -o ClearAllForwardings=yes -o ForwardAgent=no \
  -o ForwardX11=no -o RequestTTY=no -o StrictHostKeyChecking=yes \
  "$DEV_EXEC_HOST" "$remote_invocation"
exit $?
