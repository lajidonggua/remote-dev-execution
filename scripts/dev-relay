#!/bin/sh

set -u
umask 077

EX_USAGE=64
EX_CONFIG=78
EX_UNAVAILABLE=69
DEFAULT_SKILL_REPO=${REMOTE_DEV_EXECUTION_REPO:-https://github.com/lajidonggua/remote-dev-execution.git}
DEFAULT_SKILL_REF=${REMOTE_DEV_EXECUTION_REF:-}

usage() {
  cat <<'EOF'
Usage:
  dev-relay setup [VM_HOST] [--project VM_PROJECT_DIR MAC_PROJECT_DIR]
                    [--shell SHELL] [--mutagen SESSION]
                    [--mutagen-host HOST]
                    [--mutagen-bin BIN]
                    [--clear-mutagen]
                    [--client claude|codex|both]
                    [--repo SKILL_REPO] [--ref SKILL_REF]
  dev-relay install-skill [--client claude|codex|both]
                          [--repo SKILL_REPO] [--ref SKILL_REF]
  dev-relay init VM_PUBLIC_KEY_FILE
  dev-relay start
  dev-relay foreground
  dev-relay status
  dev-relay stop
  dev-relay print-vm-config [VM_PRIVATE_KEY_PATH]

Run a loopback-only user sshd on macOS and expose it to an SSH-accessible VM
through a Mac-initiated reverse tunnel. No administrator privileges required.

Setup values and options:
  VM_HOST              Existing Mac-side SSH alias for the VM.
  --project VM_PROJECT_DIR MAC_PROJECT_DIR
                       Existing absolute Agent and authoritative checkout
                       paths. Both values are required together.
  --shell SHELL        Shell executable in the authoritative environment.
  --mutagen SESSION    Existing Mutagen session; requires --project. By
                       default it is controlled where dev-exec runs. This does
                       not install or create Mutagen.
  --mutagen-host HOST  SSH alias where the existing Mutagen daemon/session
                       runs; requires --project and --mutagen.
  --mutagen-bin BIN    Mutagen executable name or absolute path in the
                       selected control environment; requires --project and
                       --mutagen. Defaults to mutagen.
  --clear-mutagen      Explicitly remove the managed Mutagen session,
                       executable, and control-host settings from the generated
                       project configuration.
  --client NAME        Install the Skill for claude, codex, or both in the VM.
                       Optional for setup; defaults to claude for install-skill.
                       Restart the Agent after installation.
  --repo REPOSITORY    Skill Git repository installed in the VM.
  --ref COMMIT         Full 40- or 64-hex Skill commit ID (required with
                       --client and for install-skill).

Use --mutagen only for an existing session. Omit it for a shared checkout or
when another synchronization preflight completes before every validation.

Configuration:
  DEV_RELAY_CONFIG, or
  ~/.config/remote-dev-execution/relay.env
EOF
}

fail() {
  code=$1
  shift
  printf 'dev-relay: %s\n' "$*" >&2
  exit "$code"
}

say() {
  printf 'dev-relay: %s\n' "$*"
}

refuse_temp_path() {
  temp_path=$1
  if [ -e "$temp_path" ] || [ -L "$temp_path" ]; then
    fail "$EX_UNAVAILABLE" "temporary path is already occupied: $temp_path"
  fi
}

command_name=${1:-help}
case $command_name in
  -h|--help|help)
    usage
    exit 0
    ;;
  setup|install-skill|init|start|foreground|status|stop|print-vm-config)
    shift
    ;;
  *)
    usage >&2
    fail "$EX_USAGE" "unknown command: $command_name"
    ;;
esac

[ -n "${HOME:-}" ] || fail "$EX_CONFIG" 'HOME is required'

config_root=${XDG_CONFIG_HOME:-$HOME/.config}
config_file=${DEV_RELAY_CONFIG:-$config_root/remote-dev-execution/relay.env}

create_default_config() {
  [ "$#" -gt 0 ] ||
    fail "$EX_USAGE" 'first-time setup requires one VM SSH alias'
  setup_host=$1
  case $setup_host in
    ''|-*|*[!A-Za-z0-9._-]*)
      fail "$EX_USAGE" 'VM SSH alias may contain only letters, digits, dots, underscores, and hyphens'
      ;;
  esac

  config_dir=$(dirname "$config_file")
  mkdir -p "$config_dir" ||
    fail "$EX_UNAVAILABLE" "cannot create configuration directory: $config_dir"
  config_tmp=$config_file.tmp.$$
  refuse_temp_path "$config_tmp"
  {
    printf '# Generated by dev-relay setup. Keep this file local.\n'
    printf 'DEV_RELAY_VM_HOST=%s\n' "$setup_host"
    printf 'DEV_RELAY_LOCAL_PORT=22022\n'
    printf 'DEV_RELAY_REMOTE_PORT=22022\n'
    printf 'DEV_RELAY_VM_ALIAS=rde-mac-dev\n'
  } > "$config_tmp" ||
    fail "$EX_UNAVAILABLE" "cannot write configuration: $config_tmp"
  chmod 0600 "$config_tmp" ||
    fail "$EX_UNAVAILABLE" "cannot secure configuration: $config_tmp"
  mv "$config_tmp" "$config_file" ||
    fail "$EX_UNAVAILABLE" "cannot install configuration: $config_file"
  say "created configuration: $config_file"
}

if [ "$command_name" = setup ] && [ ! -f "$config_file" ]; then
  [ ! -L "$config_file" ] ||
    fail "$EX_CONFIG" "configuration path is a symlink: $config_file"
  create_default_config "$@"
fi

[ -f "$config_file" ] ||
  fail "$EX_CONFIG" "configuration not found: $config_file"
[ ! -L "$config_file" ] ||
  fail "$EX_CONFIG" "configuration path is a symlink: $config_file"

# The relay configuration is trusted shell syntax.
# shellcheck disable=SC1090
. "$config_file"
config_status=$?
[ "$config_status" -eq 0 ] ||
  fail "$config_status" "failed to load configuration: $config_file"

set -f

vm_host=${DEV_RELAY_VM_HOST:-}
local_port=${DEV_RELAY_LOCAL_PORT:-22022}
remote_port=${DEV_RELAY_REMOTE_PORT:-22022}
vm_alias=${DEV_RELAY_VM_ALIAS:-rde-mac-dev}
debug_ports=${DEV_RELAY_DEBUG_PORTS:-}
state_root=${XDG_STATE_HOME:-$HOME/.local/state}
state_dir=${DEV_RELAY_STATE_DIR:-$state_root/remote-dev-execution/relay}
user_id=$(id -u) || fail "$EX_UNAVAILABLE" 'cannot determine the current user id'
runtime_root=${TMPDIR:-/tmp}
runtime_dir=${DEV_RELAY_RUNTIME_DIR:-${runtime_root%/}/rde-$user_id}
ssh_bin=${DEV_RELAY_SSH_BIN:-/usr/bin/ssh}
sshd_bin=${DEV_RELAY_SSHD_BIN:-/usr/sbin/sshd}
ssh_keygen_bin=${DEV_RELAY_SSH_KEYGEN_BIN:-/usr/bin/ssh-keygen}
outer_ssh_config=${DEV_RELAY_OUTER_SSH_CONFIG:-}

[ -n "$vm_host" ] || fail "$EX_CONFIG" 'DEV_RELAY_VM_HOST is required'
case $vm_host in
  -*) fail "$EX_CONFIG" 'DEV_RELAY_VM_HOST must not begin with a hyphen' ;;
  *'
'*) fail "$EX_CONFIG" 'DEV_RELAY_VM_HOST must not contain a newline' ;;
esac

case $vm_alias in
  ''|-*|*[!A-Za-z0-9._-]*)
    fail "$EX_CONFIG" 'DEV_RELAY_VM_ALIAS must not begin with a hyphen and may contain only letters, digits, dots, underscores, and hyphens'
    ;;
esac
case $vm_alias in
  rde-?*) ;;
  *) fail "$EX_CONFIG" 'DEV_RELAY_VM_ALIAS must use the reserved rde- prefix' ;;
esac

case $state_dir in
  "$HOME"/*) ;;
  *) fail "$EX_CONFIG" 'DEV_RELAY_STATE_DIR must be an absolute path below HOME' ;;
esac
case /${state_dir#"$HOME"/}/ in
  */../*|*/./*)
    fail "$EX_CONFIG" 'DEV_RELAY_STATE_DIR must not contain dot path components'
    ;;
esac

case $runtime_dir in
  /*) ;;
  *) fail "$EX_CONFIG" 'DEV_RELAY_RUNTIME_DIR must be an absolute path' ;;
esac
case $runtime_dir in
  *'
'*) fail "$EX_CONFIG" 'DEV_RELAY_RUNTIME_DIR must not contain a newline' ;;
esac
case $state_dir in
  *'
'*) fail "$EX_CONFIG" 'DEV_RELAY_STATE_DIR must not contain a newline' ;;
esac

[ -x "$ssh_bin" ] || fail "$EX_CONFIG" "SSH executable not found: $ssh_bin"
[ -x "$sshd_bin" ] || fail "$EX_CONFIG" "sshd executable not found: $sshd_bin"
[ -x "$ssh_keygen_bin" ] ||
  fail "$EX_CONFIG" "ssh-keygen executable not found: $ssh_keygen_bin"

if [ -n "$outer_ssh_config" ] && [ ! -r "$outer_ssh_config" ]; then
  fail "$EX_CONFIG" "outer SSH config is not readable: $outer_ssh_config"
fi

validate_port() {
  port_name=$1
  port_value=$2
  case $port_value in
    ''|*[!0-9]*)
      fail "$EX_CONFIG" "$port_name must be an integer from 1024 to 65535"
      ;;
  esac
  if [ "$port_value" -lt 1024 ] || [ "$port_value" -gt 65535 ]; then
    fail "$EX_CONFIG" "$port_name must be an integer from 1024 to 65535"
  fi
}

validate_port DEV_RELAY_LOCAL_PORT "$local_port"
validate_port DEV_RELAY_REMOTE_PORT "$remote_port"

seen_debug_ports=" $remote_port "
for debug_port in $debug_ports; do
  validate_port DEV_RELAY_DEBUG_PORTS "$debug_port"
  if [ "$debug_port" -eq "$local_port" ]; then
    fail "$EX_CONFIG" "debug port $debug_port conflicts with DEV_RELAY_LOCAL_PORT"
  fi
  case $seen_debug_ports in
    *" $debug_port "*)
      fail "$EX_CONFIG" "duplicate or conflicting remote port: $debug_port"
      ;;
  esac
  seen_debug_ports="$seen_debug_ports$debug_port "
done

host_key=$state_dir/ssh_host_ed25519_key
host_public_key=$host_key.pub
authorized_keys=$state_dir/authorized_keys
sshd_config=$state_dir/sshd_config
sshd_pid=$state_dir/sshd.pid
sshd_log=$state_dir/sshd.log
state_marker=$state_dir/.remote-dev-execution-state
tunnel_state=$state_dir/active-tunnel
control_socket=$runtime_dir/r-$remote_port.ctl

if [ "${#control_socket}" -gt 90 ]; then
  fail "$EX_CONFIG" 'DEV_RELAY_RUNTIME_DIR is too long for an SSH control socket'
fi

script_dir=$(CDPATH= cd -P "$(dirname "$0")" 2>/dev/null && pwd) ||
  fail "$EX_UNAVAILABLE" 'cannot resolve the dev-relay script directory'
script_path=$script_dir/$(basename "$0")

ensure_state_dir() {
  if [ -L "$state_dir" ]; then
    fail "$EX_UNAVAILABLE" "state directory must not be a symlink: $state_dir"
  fi
  mkdir -p "$state_dir" ||
    fail "$EX_UNAVAILABLE" "cannot create state directory: $state_dir"
  canonical_home=$(CDPATH= cd -P "$HOME" 2>/dev/null && pwd) ||
    fail "$EX_UNAVAILABLE" 'cannot resolve HOME'
  canonical_state=$(CDPATH= cd -P "$state_dir" 2>/dev/null && pwd) ||
    fail "$EX_UNAVAILABLE" "cannot resolve state directory: $state_dir"
  case $canonical_state in
    "$canonical_home/.ssh")
      fail "$EX_UNAVAILABLE" 'DEV_RELAY_STATE_DIR must not be the user SSH directory'
      ;;
    "$canonical_home"/*) ;;
    *) fail "$EX_UNAVAILABLE" 'state directory resolves outside HOME' ;;
  esac
  state_owner=$(stat -f '%u' "$state_dir" 2>/dev/null) ||
    fail "$EX_UNAVAILABLE" "cannot inspect state directory ownership: $state_dir"
  [ "$state_owner" = "$user_id" ] ||
    fail "$EX_UNAVAILABLE" "state directory is not owned by uid $user_id"
  chmod 0700 "$state_dir" ||
    fail "$EX_UNAVAILABLE" "cannot secure state directory: $state_dir"

  for managed_state_path in \
    "$host_key" "$host_public_key" "$authorized_keys" "$sshd_config" \
    "$sshd_pid" "$sshd_log" "$state_marker" "$tunnel_state"; do
    [ ! -L "$managed_state_path" ] ||
      fail "$EX_UNAVAILABLE" "managed relay state must not be a symlink: $managed_state_path"
  done

  if [ ! -f "$state_marker" ]; then
    if [ -e "$state_marker" ]; then
      fail "$EX_UNAVAILABLE" "state ownership marker must be a regular file: $state_marker"
    fi
    first_state_entry=$(find "$state_dir" -mindepth 1 -maxdepth 1 -print -quit 2>/dev/null) ||
      fail "$EX_UNAVAILABLE" "cannot inspect state directory: $state_dir"
    if [ -n "$first_state_entry" ]; then
      if [ ! -f "$host_key" ] || [ ! -f "$authorized_keys" ] || [ ! -f "$sshd_config" ] ||
        ! grep -q '^ListenAddress 127\.0\.0\.1$' "$sshd_config" 2>/dev/null; then
        fail "$EX_UNAVAILABLE" "state directory is nonempty and is not a recognized relay state: $state_dir"
      fi
    fi
    printf '%s\n' 'remote-dev-execution relay state v1' > "$state_marker" ||
      fail "$EX_UNAVAILABLE" "cannot create state ownership marker: $state_marker"
    chmod 0600 "$state_marker" ||
      fail "$EX_UNAVAILABLE" "cannot secure state ownership marker: $state_marker"
  fi
  IFS= read -r marker_text < "$state_marker" ||
    fail "$EX_UNAVAILABLE" "cannot read state ownership marker: $state_marker"
  [ "$marker_text" = 'remote-dev-execution relay state v1' ] ||
    fail "$EX_UNAVAILABLE" "unrecognized state ownership marker: $state_marker"
}

ensure_runtime_dir() {
  if [ -L "$runtime_dir" ]; then
    fail "$EX_UNAVAILABLE" "runtime directory must not be a symlink: $runtime_dir"
  fi
  mkdir -p "$runtime_dir" ||
    fail "$EX_UNAVAILABLE" "cannot create runtime directory: $runtime_dir"
  runtime_owner=$(stat -f '%u' "$runtime_dir" 2>/dev/null) ||
    fail "$EX_UNAVAILABLE" "cannot inspect runtime directory ownership: $runtime_dir"
  [ "$runtime_owner" = "$user_id" ] ||
    fail "$EX_UNAVAILABLE" "runtime directory is not owned by uid $user_id"
  chmod 0700 "$runtime_dir" ||
    fail "$EX_UNAVAILABLE" "cannot secure runtime directory: $runtime_dir"
}

ensure_initialized() {
  [ -f "$host_key" ] ||
    fail "$EX_CONFIG" "relay is not initialized; run: $script_path init VM_PUBLIC_KEY_FILE"
  [ -f "$authorized_keys" ] ||
    fail "$EX_CONFIG" "authorized keys are missing; rerun dev-relay init"
  [ -f "$sshd_config" ] ||
    fail "$EX_CONFIG" "sshd configuration is missing; rerun dev-relay init"
}

sshd_quote() {
  escaped=$(printf '%s' "$1" | sed 's/\\/\\\\/g; s/"/\\"/g') || return 1
  printf '"%s"' "$escaped"
}

shell_quote_value() {
  escaped=$(printf '%s_' "$1" | sed "s/'/'\\\\''/g") || return 1
  escaped=${escaped%_}
  printf "'%s'" "$escaped"
}

write_sshd_config() {
  config_tmp=$state_dir/sshd_config.tmp
  refuse_temp_path "$config_tmp"
  user_name=$(id -un) ||
    fail "$EX_UNAVAILABLE" 'cannot determine the current user'
  case $user_name in
    ''|*[!A-Za-z0-9._-]*)
      fail "$EX_CONFIG" 'the current username cannot be represented safely in sshd_config'
      ;;
  esac

  if ! quoted_host_key=$(sshd_quote "$host_key"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the relay host-key path'
  fi
  if ! quoted_pid=$(sshd_quote "$sshd_pid"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the relay pid-file path'
  fi
  if ! quoted_authorized_keys=$(sshd_quote "$authorized_keys"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the relay authorized-keys path'
  fi

  {
    printf 'Port %s\n' "$local_port"
    printf 'ListenAddress 127.0.0.1\n'
    printf 'AddressFamily inet\n'
    printf 'HostKey %s\n' "$quoted_host_key"
    printf 'PidFile %s\n' "$quoted_pid"
    printf 'AuthorizedKeysFile %s\n' "$quoted_authorized_keys"
    printf 'AuthenticationMethods publickey\n'
    printf 'PubkeyAuthentication yes\n'
    printf 'PasswordAuthentication no\n'
    printf 'KbdInteractiveAuthentication no\n'
    printf 'ChallengeResponseAuthentication no\n'
    printf 'PermitEmptyPasswords no\n'
    printf 'UsePAM no\n'
    printf 'PermitRootLogin no\n'
    printf 'StrictModes yes\n'
    printf 'AllowUsers %s\n' "$user_name"
    printf 'DisableForwarding yes\n'
    printf 'AllowTcpForwarding no\n'
    printf 'AllowStreamLocalForwarding no\n'
    printf 'AllowAgentForwarding no\n'
    printf 'GatewayPorts no\n'
    printf 'X11Forwarding no\n'
    printf 'PermitTunnel no\n'
    printf 'PermitUserEnvironment no\n'
    printf 'PermitUserRC no\n'
    printf 'PermitTTY yes\n'
    printf 'MaxAuthTries 3\n'
    printf 'MaxSessions 4\n'
    printf 'LoginGraceTime 30\n'
    printf 'ClientAliveInterval 60\n'
    printf 'ClientAliveCountMax 3\n'
    printf 'UseDNS no\n'
    printf 'PrintMotd no\n'
    printf 'LogLevel VERBOSE\n'
    printf 'Subsystem sftp internal-sftp\n'
  } > "$config_tmp" ||
    fail "$EX_UNAVAILABLE" "cannot write temporary sshd config: $config_tmp"

  chmod 0600 "$config_tmp" ||
    fail "$EX_UNAVAILABLE" "cannot secure temporary sshd config: $config_tmp"

  if ! "$sshd_bin" -t -f "$config_tmp"; then
    rm -f "$config_tmp"
    fail "$EX_CONFIG" 'generated sshd configuration failed validation'
  fi

  mv "$config_tmp" "$sshd_config" ||
    fail "$EX_UNAVAILABLE" "cannot install sshd config: $sshd_config"
}

read_pid() {
  pid_file=$1
  [ -f "$pid_file" ] || return 1
  IFS= read -r process_pid < "$pid_file" || return 1
  case $process_pid in
    ''|*[!0-9]*) return 1 ;;
  esac
  printf '%s\n' "$process_pid"
}

pid_matches() {
  process_pid=$1
  expected_text=$2
  kill -0 "$process_pid" 2>/dev/null || return 1
  process_command=$(ps -p "$process_pid" -o command= 2>/dev/null) || return 1
  case $process_command in
    *"$expected_text"*) return 0 ;;
    *) return 1 ;;
  esac
}

sshd_running() {
  relay_sshd_pid=$(read_pid "$sshd_pid") || return 1
  pid_matches "$relay_sshd_pid" "$sshd_config"
}

control_command() {
  operation=$1
  shift
  set --
  if [ -n "$outer_ssh_config" ]; then
    set -- "$@" -F "$outer_ssh_config"
  fi
  set -- "$@" -S "$control_socket" -O "$operation" "$vm_host"
  "$ssh_bin" "$@"
}

control_command_at() {
  recorded_socket=$1
  operation=$2
  recorded_host=$3
  set --
  if [ -n "$outer_ssh_config" ]; then
    set -- "$@" -F "$outer_ssh_config"
  fi
  set -- "$@" -S "$recorded_socket" -O "$operation" "$recorded_host"
  "$ssh_bin" "$@"
}

read_tunnel_state() {
  [ -f "$tunnel_state" ] || return 1
  [ ! -L "$tunnel_state" ] ||
    fail "$EX_UNAVAILABLE" "active tunnel record must not be a symlink: $tunnel_state"
  recorded_socket=
  recorded_host=
  tunnel_state_valid=1
  {
    IFS= read -r recorded_socket || tunnel_state_valid=0
    IFS= read -r recorded_host || tunnel_state_valid=0
    if IFS= read -r unexpected_line; then
      tunnel_state_valid=0
    fi
  } < "$tunnel_state"
  [ "$tunnel_state_valid" -eq 1 ] ||
    fail "$EX_UNAVAILABLE" "active tunnel record is invalid: $tunnel_state"
  case $recorded_socket in
    /*) ;;
    *) fail "$EX_UNAVAILABLE" "recorded control socket is invalid: $tunnel_state" ;;
  esac
  case $recorded_host in
    ''|-*|*'
'*) fail "$EX_UNAVAILABLE" "recorded VM host is invalid: $tunnel_state" ;;
  esac
}

write_tunnel_state() {
  tunnel_state_tmp=$tunnel_state.tmp.$$
  refuse_temp_path "$tunnel_state_tmp"
  {
    printf '%s\n' "$control_socket"
    printf '%s\n' "$vm_host"
  } > "$tunnel_state_tmp" || return 1
  chmod 0600 "$tunnel_state_tmp" || return 1
  mv "$tunnel_state_tmp" "$tunnel_state"
}

stop_recorded_tunnel() {
  if ! read_tunnel_state; then
    return 0
  fi
  if [ -S "$recorded_socket" ]; then
    control_command_at "$recorded_socket" exit "$recorded_host" >/dev/null 2>&1 ||
      return $?
    rm -f "$recorded_socket"
  elif [ -e "$recorded_socket" ] || [ -L "$recorded_socket" ]; then
    fail "$EX_UNAVAILABLE" "recorded control-socket path is not a socket: $recorded_socket"
  fi
  rm -f "$tunnel_state"
}

recorded_tunnel_running() {
  read_tunnel_state || return 1
  [ -S "$recorded_socket" ] || return 1
  control_command_at "$recorded_socket" check "$recorded_host" >/dev/null 2>&1
}

remove_stale_control_socket() {
  if [ -S "$control_socket" ]; then
    rm -f "$control_socket"
  elif [ -e "$control_socket" ] || [ -L "$control_socket" ]; then
    fail "$EX_UNAVAILABLE" "control-socket path is occupied by a non-socket: $control_socket"
  fi
}

outer_ssh_command() {
  remote_command=$1
  set --
  if [ -n "$outer_ssh_config" ]; then
    set -- "$@" -F "$outer_ssh_config"
  fi
  set -- "$@" -T
  set -- "$@" -o BatchMode=yes
  set -- "$@" -o ClearAllForwardings=yes
  set -- "$@" -o ForwardAgent=no
  set -- "$@" -o ForwardX11=no
  set -- "$@" -o RequestTTY=no
  set -- "$@" -o StrictHostKeyChecking=yes
  set -- "$@" "$vm_host" "$remote_command"
  "$ssh_bin" "$@"
}

tunnel_running() {
  [ -S "$control_socket" ] || return 1
  control_command check >/dev/null 2>&1
}

start_sshd() {
  ensure_initialized
  ensure_state_dir

  if sshd_running; then
    return 0
  fi

  if [ -f "$sshd_pid" ]; then
    stale_pid=$(read_pid "$sshd_pid" 2>/dev/null || true)
    if [ -n "$stale_pid" ] && kill -0 "$stale_pid" 2>/dev/null; then
      fail "$EX_UNAVAILABLE" "refusing to replace pid file for unrelated process $stale_pid"
    fi
    rm -f "$sshd_pid"
  fi

  "$sshd_bin" -t -f "$sshd_config" ||
    fail "$EX_CONFIG" 'sshd configuration failed validation'
  "$sshd_bin" -f "$sshd_config" -E "$sshd_log" ||
    fail "$EX_UNAVAILABLE" "user sshd failed to start; inspect $sshd_log"

  attempt=0
  while [ "$attempt" -lt 50 ]; do
    if sshd_running; then
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done

  fail "$EX_UNAVAILABLE" "user sshd did not become ready; inspect $sshd_log"
}

stop_sshd() {
  if ! relay_sshd_pid=$(read_pid "$sshd_pid" 2>/dev/null); then
    rm -f "$sshd_pid"
    return 0
  fi

  if ! pid_matches "$relay_sshd_pid" "$sshd_config"; then
    fail "$EX_UNAVAILABLE" "refusing to stop unrelated process $relay_sshd_pid"
  fi

  kill "$relay_sshd_pid" ||
    fail "$EX_UNAVAILABLE" "cannot stop user sshd process $relay_sshd_pid"

  attempt=0
  while [ "$attempt" -lt 50 ]; do
    if ! kill -0 "$relay_sshd_pid" 2>/dev/null; then
      rm -f "$sshd_pid"
      return 0
    fi
    attempt=$((attempt + 1))
    sleep 0.1
  done

  fail "$EX_UNAVAILABLE" "user sshd process $relay_sshd_pid did not stop"
}

run_tunnel() {
  tunnel_mode=$1
  set --

  if [ -n "$outer_ssh_config" ]; then
    set -- "$@" -F "$outer_ssh_config"
  fi

  set -- "$@" -M -S "$control_socket"
  if [ "$tunnel_mode" = background ]; then
    set -- "$@" -f
  fi

  set -- "$@" -N -T
  set -- "$@" -o BatchMode=yes
  # The outer alias is required to be free of unrelated forwards. Setting this
  # to yes would also discard the explicit -R options added below.
  set -- "$@" -o ClearAllForwardings=no
  set -- "$@" -o ExitOnForwardFailure=yes
  set -- "$@" -o ForwardAgent=no
  set -- "$@" -o ForwardX11=no
  set -- "$@" -o RequestTTY=no
  set -- "$@" -o ServerAliveInterval=30
  set -- "$@" -o ServerAliveCountMax=3
  set -- "$@" -o StrictHostKeyChecking=yes
  set -- "$@" -o ControlMaster=yes
  set -- "$@" -o ControlPersist=no
  set -- "$@" -R "127.0.0.1:$remote_port:127.0.0.1:$local_port"

  for debug_port in $debug_ports; do
    set -- "$@" -R "127.0.0.1:$debug_port:127.0.0.1:$debug_port"
  done

  set -- "$@" "$vm_host"
  "$ssh_bin" "$@"
}

start_tunnel() {
  if tunnel_running; then
    write_tunnel_state || return $?
    return 0
  fi

  stop_recorded_tunnel || return $?
  ensure_runtime_dir
  if [ -S "$control_socket" ]; then
    fail "$EX_UNAVAILABLE" "control socket exists but is not responding: $control_socket"
  elif [ -e "$control_socket" ] || [ -L "$control_socket" ]; then
    fail "$EX_UNAVAILABLE" "control-socket path is occupied by a non-socket: $control_socket"
  fi
  run_tunnel background || return $?
  tunnel_running || return $?
  write_tunnel_state
}

stop_tunnel() {
  stop_recorded_tunnel || return $?
  if tunnel_running; then
    control_command exit >/dev/null 2>&1 || return $?
  fi
  if [ -S "$control_socket" ]; then
    rm -f "$control_socket"
  elif [ -e "$control_socket" ] || [ -L "$control_socket" ]; then
    fail "$EX_UNAVAILABLE" "control-socket path is occupied by a non-socket: $control_socket"
  fi
}

initialize_relay() {
  [ "$#" -eq 1 ] || fail "$EX_USAGE" 'init requires one VM public-key file'
  public_key_source=$1
  [ -r "$public_key_source" ] ||
    fail "$EX_CONFIG" "VM public key is not readable: $public_key_source"

  IFS= read -r public_key_line < "$public_key_source" ||
    fail "$EX_CONFIG" 'VM public-key file is empty'
  case $public_key_line in
    ssh-ed25519\ *|sk-ssh-ed25519@openssh.com\ *) ;;
    *) fail "$EX_CONFIG" 'use a dedicated Ed25519 VM public key, not a private key' ;;
  esac
  second_line=$(sed -n '2p' "$public_key_source")
  [ -z "$second_line" ] ||
    fail "$EX_CONFIG" 'VM public-key file must contain exactly one key'
  "$ssh_keygen_bin" -l -f "$public_key_source" >/dev/null 2>&1 ||
    fail "$EX_CONFIG" 'VM public-key file is invalid'

  ensure_state_dir

  authorized_tmp=$state_dir/authorized_keys.tmp
  refuse_temp_path "$authorized_tmp"
  cp "$public_key_source" "$authorized_tmp" ||
    fail "$EX_UNAVAILABLE" 'cannot copy the VM public key'
  chmod 0600 "$authorized_tmp" ||
    fail "$EX_UNAVAILABLE" 'cannot secure the VM public key'
  mv "$authorized_tmp" "$authorized_keys" ||
    fail "$EX_UNAVAILABLE" 'cannot install the VM public key'

  if [ ! -f "$host_key" ]; then
    "$ssh_keygen_bin" -q -t ed25519 -N '' -f "$host_key" ||
      fail "$EX_UNAVAILABLE" 'cannot generate the user sshd host key'
  fi
  chmod 0600 "$host_key"
  chmod 0644 "$host_public_key"

  write_sshd_config
  say "initialized user sshd state in $state_dir"
  say "run '$script_path print-vm-config' for the VM-side SSH entries"
}

vm_host_material() {
  host_material=$(awk 'NR == 1 { print $1 " " $2 }' "$host_public_key")
  [ -n "$host_material" ] ||
    fail "$EX_CONFIG" 'relay host public key is invalid'
  printf '%s\n' "$host_material"
}

vm_ssh_config() {
  vm_identity=$1
  cat <<EOF
Host $vm_alias
  HostName 127.0.0.1
  Port $remote_port
  User $(id -un)
  IdentityFile $vm_identity
  IdentitiesOnly yes
  ProxyCommand none
  ProxyJump none
  ClearAllForwardings yes
  ForwardAgent no
  ForwardX11 no
  HostKeyAlias $vm_alias
  UserKnownHostsFile ~/.ssh/remote-dev-execution/known_hosts
  StrictHostKeyChecking yes
EOF
}

vm_known_host() {
  relay_host_material=$(vm_host_material) || return $?
  printf '%s %s\n' "$vm_alias" "$relay_host_material"
}

validate_project_value() {
  project_value_name=$1
  project_value=$2
  case $project_value in
    *'
'*) fail "$EX_USAGE" "$project_value_name must not contain a newline" ;;
  esac
}

validate_project_path() {
  project_path_name=$1
  project_path_value=$2
  validate_project_value "$project_path_name" "$project_path_value"
  case $project_path_value in
    /*) ;;
    *) fail "$EX_USAGE" "$project_path_name must be an absolute path" ;;
  esac
}

validate_project_request() {
  [ "${project_requested:-0}" -eq 1 ] || return 0
  validate_project_path VM_PROJECT_DIR "$project_vm_dir"
  validate_project_path MAC_PROJECT_DIR "$project_mac_dir"
  validate_project_value DEV_EXEC_SHELL "$project_shell"
  validate_project_value DEV_EXEC_MUTAGEN_SESSION "$project_mutagen"
  validate_project_value DEV_EXEC_MUTAGEN_HOST "$project_mutagen_host"
  validate_project_value DEV_EXEC_MUTAGEN_BIN "$project_mutagen_bin"
  if [ "${project_mutagen_set:-0}" -eq 1 ] && [ -z "$project_mutagen" ]; then
    fail "$EX_USAGE" '--mutagen requires a non-empty session name'
  fi
  if [ "${project_clear_mutagen:-0}" -eq 1 ] && [ "${project_mutagen_set:-0}" -eq 1 ]; then
    fail "$EX_USAGE" '--clear-mutagen cannot be combined with --mutagen'
  fi
  case $project_mutagen in
    -*) fail "$EX_USAGE" 'DEV_EXEC_MUTAGEN_SESSION must not begin with a hyphen' ;;
  esac
  case $project_mutagen_host in
    -*) fail "$EX_USAGE" 'DEV_EXEC_MUTAGEN_HOST must not begin with a hyphen' ;;
  esac
  case $project_mutagen_bin in
    -*) fail "$EX_USAGE" 'DEV_EXEC_MUTAGEN_BIN must not begin with a hyphen' ;;
  esac
  if [ -n "$project_mutagen_host" ] && [ "$project_mutagen_set" -eq 0 ]; then
    fail "$EX_USAGE" '--mutagen-host requires --mutagen during setup'
  fi
  if [ -n "$project_mutagen_bin" ] && [ "$project_mutagen_set" -eq 0 ]; then
    fail "$EX_USAGE" '--mutagen-bin requires --mutagen during setup'
  fi
}

validate_skill_request() {
  case $skill_client in
    claude|codex|both) ;;
    *) fail "$EX_USAGE" '--client must be claude, codex, or both' ;;
  esac
  validate_project_value SKILL_REPO "$skill_repo"
  validate_project_value SKILL_REF "$skill_ref"
  case $skill_repo in
    ''|-*) fail "$EX_USAGE" 'SKILL_REPO must be non-empty and must not begin with a hyphen' ;;
  esac
  case $skill_ref in
    ''|-*) fail "$EX_USAGE" 'SKILL_REF must be non-empty and must not begin with a hyphen' ;;
  esac
  case $skill_ref in
    *[!A-Fa-f0-9]*) fail "$EX_USAGE" 'SKILL_REF must be a full 40- or 64-hex commit ID' ;;
  esac
  case ${#skill_ref} in
    40|64) ;;
    *) fail "$EX_USAGE" 'SKILL_REF must be a full 40- or 64-hex commit ID' ;;
  esac
}

preflight_vm_project_config() {
  [ "${project_requested:-0}" -eq 1 ] || return 0

  validate_project_request

  project_preflight_script='set -eu
IFS= read -r vm_project
case $vm_project in
  /*) ;;
  *)
    printf "%s\n" "dev-relay: VM project path must be absolute" >&2
    exit 64
    ;;
esac
if [ ! -d "$vm_project" ]; then
  printf "%s\n" "dev-relay: VM project directory does not exist: $vm_project" >&2
  exit 78
fi
config=$vm_project/.dev-exec.env
if [ -L "$config" ]; then
  printf "%s\n" "dev-relay: refusing to replace symlinked project config: $config" >&2
  exit 78
fi
if [ -e "$config" ] && [ ! -f "$config" ]; then
  printf "%s\n" "dev-relay: project config is not a regular file: $config" >&2
  exit 78
fi
if [ -f "$config" ]; then
  IFS= read -r marker < "$config" || marker=
  if [ "$marker" != "# Generated by remote-dev-execution dev-relay setup" ]; then
    printf "%s\n" "dev-relay: existing project config is unmanaged: $config" >&2
    printf "%s\n" "dev-relay: preserve it by rerunning setup without --project, or move it aside and rerun this command" >&2
    exit 78
  fi
fi'

  printf '%s\n' "$project_vm_dir" | outer_ssh_command "$project_preflight_script" ||
    fail "$EX_CONFIG" 'project configuration preflight failed before relay setup'
}

write_vm_project_config() {
  [ "${project_requested:-0}" -eq 1 ] || return 0

  validate_project_request

  if ! quoted_host=$(shell_quote_value "$vm_alias"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the relay SSH alias for project configuration'
  fi
  if ! quoted_dir=$(shell_quote_value "$project_mac_dir"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the Mac project path'
  fi
  if [ -n "$project_shell" ] &&
    ! quoted_shell=$(shell_quote_value "$project_shell"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the project shell'
  fi
  if [ -n "$project_mutagen" ] &&
    ! quoted_mutagen=$(shell_quote_value "$project_mutagen"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the Mutagen session'
  fi
  if [ -n "$project_mutagen_host" ] &&
    ! quoted_mutagen_host=$(shell_quote_value "$project_mutagen_host"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the Mutagen control host'
  fi
  if [ -n "$project_mutagen_bin" ] &&
    ! quoted_mutagen_bin=$(shell_quote_value "$project_mutagen_bin"); then
    fail "$EX_UNAVAILABLE" 'cannot quote the Mutagen executable'
  fi

  project_remote_script='set -eu
umask 077
IFS= read -r vm_project
IFS= read -r clear_mutagen
case $clear_mutagen in
  0|1) ;;
  *)
    printf "%s\n" "dev-relay: invalid Mutagen preservation mode" >&2
    exit 64
    ;;
esac
case $vm_project in
  /*) ;;
  *)
    printf "%s\n" "dev-relay: VM project path must be absolute" >&2
    exit 64
    ;;
esac
if [ ! -d "$vm_project" ]; then
  printf "%s\n" "dev-relay: VM project directory does not exist: $vm_project" >&2
  exit 78
fi
config=$vm_project/.dev-exec.env
if [ -L "$config" ]; then
  printf "%s\n" "dev-relay: refusing to replace symlinked project config: $config" >&2
  exit 78
fi
if [ -e "$config" ] && [ ! -f "$config" ]; then
  printf "%s\n" "dev-relay: project config is not a regular file: $config" >&2
  exit 78
fi
if [ -f "$config" ]; then
  IFS= read -r marker < "$config" || marker=
  if [ "$marker" != "# Generated by remote-dev-execution dev-relay setup" ]; then
    printf "%s\n" "dev-relay: existing project config is unmanaged: $config" >&2
    printf "%s\n" "dev-relay: preserve it by rerunning setup without --project, or move it aside and rerun this command" >&2
    exit 78
  fi
fi
extract_assignment() {
  assignment_name=$1
  assignment_file=$2
  awk -v name="$assignment_name" "
    {
      line=\$0
      sub(/^[[:space:]]*export[[:space:]]+/, \"\", line)
      sub(/^[[:space:]]*/, \"\", line)
      if (index(line, name \"=\") == 1) {
        print line
        exit
      }
    }
  " "$assignment_file"
}
preserved_mutagen_session=
preserved_mutagen_bin=
preserved_mutagen_host=
if [ -f "$config" ] && [ "$clear_mutagen" -eq 0 ]; then
  preserved_mutagen_session=$(extract_assignment DEV_EXEC_MUTAGEN_SESSION "$config" || true)
  preserved_mutagen_bin=$(extract_assignment DEV_EXEC_MUTAGEN_BIN "$config" || true)
  preserved_mutagen_host=$(extract_assignment DEV_EXEC_MUTAGEN_HOST "$config" || true)
fi
config_tmp=$config.tmp.$$
if [ -e "$config_tmp" ] || [ -L "$config_tmp" ]; then
  printf "%s\n" "dev-relay: temporary project config path is occupied: $config_tmp" >&2
  exit 69
fi
cat > "$config_tmp"
if [ "$clear_mutagen" -eq 0 ]; then
  if ! grep -Eq "^[[:space:]]*(export[[:space:]]+)?DEV_EXEC_MUTAGEN_SESSION=" "$config_tmp" &&
    [ -n "$preserved_mutagen_session" ]; then
    printf "\n%s\n" "$preserved_mutagen_session" >> "$config_tmp"
  fi
  if ! grep -Eq "^[[:space:]]*(export[[:space:]]+)?DEV_EXEC_MUTAGEN_BIN=" "$config_tmp" &&
    [ -n "$preserved_mutagen_bin" ]; then
    printf "%s\n" "$preserved_mutagen_bin" >> "$config_tmp"
  fi
  if ! grep -Eq "^[[:space:]]*(export[[:space:]]+)?DEV_EXEC_MUTAGEN_HOST=" "$config_tmp" &&
    [ -n "$preserved_mutagen_host" ]; then
    printf "%s\n" "$preserved_mutagen_host" >> "$config_tmp"
  fi
fi
chmod 0600 "$config_tmp"
mv "$config_tmp" "$config"

if command -v git >/dev/null 2>&1; then
  git_dir=$(git -C "$vm_project" rev-parse --git-dir 2>/dev/null || true)
  if [ -n "$git_dir" ]; then
    case $git_dir in
      /*) ;;
      *) git_dir=$vm_project/$git_dir ;;
    esac
    exclude=$git_dir/info/exclude
    if [ -L "$exclude" ]; then
      printf "%s\n" "dev-relay: project Git exclude is a symlink; config was generated but was not added to ignore rules" >&2
    elif touch "$exclude" 2>/dev/null; then
      if ! grep -Fqx ".dev-exec.env" "$exclude" 2>/dev/null; then
        printf "\n# remote-dev-execution\n.dev-exec.env\n" >> "$exclude"
      fi
    else
      printf "%s\n" "dev-relay: could not update Git exclude; do not commit $config" >&2
    fi
  fi
fi
printf "%s\n" "dev-relay: configured VM project $vm_project"'

  {
    printf '%s\n' "$project_vm_dir"
    printf '%s\n' "$project_clear_mutagen"
    printf '%s\n' '# Generated by remote-dev-execution dev-relay setup'
    printf 'DEV_EXEC_HOST=%s\n' "$quoted_host"
    printf 'DEV_EXEC_DIR=%s\n' "$quoted_dir"
    if [ -n "$project_shell" ]; then
      printf 'DEV_EXEC_SHELL=%s\n' "$quoted_shell"
    fi
    if [ -n "$project_mutagen" ]; then
      printf 'DEV_EXEC_MUTAGEN_SESSION=%s\n' "$quoted_mutagen"
    fi
    if [ -n "$project_mutagen_host" ]; then
      printf 'DEV_EXEC_MUTAGEN_HOST=%s\n' "$quoted_mutagen_host"
    fi
    if [ -n "$project_mutagen_bin" ]; then
      printf 'DEV_EXEC_MUTAGEN_BIN=%s\n' "$quoted_mutagen_bin"
    fi
  } | outer_ssh_command "$project_remote_script" ||
    fail "$EX_UNAVAILABLE" "cannot configure VM project: $project_vm_dir"
}

install_vm_skill() {
  [ -n "${skill_client:-}" ] || return 0
  validate_skill_request

  installer=$script_dir/install-skill.sh
  [ -r "$installer" ] ||
    fail "$EX_UNAVAILABLE" "Skill installer is not readable: $installer"
  quoted_skill_repo=$(shell_quote_value "$skill_repo") ||
    fail "$EX_UNAVAILABLE" 'cannot quote the Skill repository'
  quoted_skill_ref=$(shell_quote_value "$skill_ref") ||
    fail "$EX_UNAVAILABLE" 'cannot quote the Skill ref'
  quoted_skill_client=$(shell_quote_value "$skill_client") ||
    fail "$EX_UNAVAILABLE" 'cannot quote the Skill client'
  remote_install_command="sh -s -- --repo $quoted_skill_repo --ref $quoted_skill_ref --client $quoted_skill_client"

  outer_ssh_command "$remote_install_command" < "$installer" || return $?
  say "VM agent Skill installed for: $skill_client"
}

install_skill_command() {
  skill_client=claude
  skill_repo=$DEFAULT_SKILL_REPO
  skill_ref=$DEFAULT_SKILL_REF
  while [ "$#" -gt 0 ]; do
    case $1 in
      --client)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--client requires a value'
        skill_client=$2
        shift 2
        ;;
      --repo)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--repo requires a value'
        skill_repo=$2
        shift 2
        ;;
      --ref)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--ref requires a value'
        skill_ref=$2
        shift 2
        ;;
      *) fail "$EX_USAGE" "unknown install-skill option: $1" ;;
    esac
  done

  install_vm_skill ||
    fail "$EX_UNAVAILABLE" 'cannot install the agent Skill in the VM'
  say 'restart the VM Agent session so it reloads the Skill'
}

install_vm_access() {
  vm_identity='~/.ssh/remote-dev-mac'
  vm_config_tmp=$state_dir/vm-ssh-config.tmp.$$
  vm_known_tmp=$state_dir/vm-known-host.tmp.$$
  refuse_temp_path "$vm_config_tmp"
  refuse_temp_path "$vm_known_tmp"
  vm_ssh_config "$vm_identity" > "$vm_config_tmp" || {
    rm -f "$vm_config_tmp" "$vm_known_tmp"
    return 1
  }
  vm_known_host > "$vm_known_tmp" || {
    rm -f "$vm_config_tmp" "$vm_known_tmp"
    return 1
  }
  remote_install_config='set -eu
umask 077
ssh_dir=$HOME/.ssh
config=$ssh_dir/config
config_dir=$ssh_dir/config.d
snippet=$config_dir/remote-dev-execution-__VM_ALIAS__
relay_host=__VM_ALIAS__
if [ -L "$config_dir" ]; then
  printf "%s\n" "dev-relay: refusing to use a symlinked VM SSH config directory" >&2
  exit 78
fi
mkdir -p "$config_dir"
chmod 0700 "$ssh_dir" "$config_dir"
for config_candidate in "$config" "$config_dir"/*; do
  [ -f "$config_candidate" ] || continue
  [ "$config_candidate" = "$snippet" ] && continue
  if awk -v target="$relay_host" "
    BEGIN { found = 0 }
    tolower(\$1) == \"host\" {
      for (field = 2; field <= NF; field++) {
        if (\$field == target) { found = 1 }
      }
    }
    END { exit(found ? 0 : 1) }
  " "$config_candidate"; then
    printf "%s\n" "dev-relay: VM SSH alias already exists outside the managed snippet: $relay_host" >&2
    exit 78
  fi
done
if [ -L "$config" ]; then
  if ! grep -Fqx "Include ~/.ssh/config.d/*" "$config"; then
    printf "%s\n" "dev-relay: VM SSH config is a symlink without the managed Include directive" >&2
    exit 78
  fi
else
  touch "$config"
  config_tmp=$config.tmp.$$
  if [ -e "$config_tmp" ] || [ -L "$config_tmp" ]; then
    printf "%s\n" "dev-relay: temporary VM SSH config path is occupied: $config_tmp" >&2
    exit 69
  fi
  {
    printf "%s\n" "Include ~/.ssh/config.d/*"
    while IFS= read -r config_line || [ -n "$config_line" ]; do
      case $config_line in
        "Include ~/.ssh/config.d/*") ;;
        *) printf "%s\n" "$config_line" ;;
      esac
    done < "$config"
  } > "$config_tmp"
  chmod 0600 "$config_tmp"
  mv "$config_tmp" "$config"
  chmod 0600 "$config"
fi
if [ -L "$snippet" ]; then
  printf "%s\n" "dev-relay: refusing to replace a symlinked managed SSH snippet" >&2
  exit 78
fi
snippet_tmp=$snippet.tmp.$$
if [ -e "$snippet_tmp" ] || [ -L "$snippet_tmp" ]; then
  printf "%s\n" "dev-relay: temporary VM SSH snippet path is occupied: $snippet_tmp" >&2
  exit 69
fi
cat > "$snippet_tmp"
chmod 0600 "$snippet_tmp"
mv "$snippet_tmp" "$snippet"'
  remote_install_config=$(printf '%s\n' "$remote_install_config" | sed "s/__VM_ALIAS__/$vm_alias/g") ||
    return 1

  if ! outer_ssh_command "$remote_install_config" < "$vm_config_tmp"; then
    rm -f "$vm_config_tmp" "$vm_known_tmp"
    return 1
  fi

  remote_install_known_host='set -eu
umask 077
ssh_dir=$HOME/.ssh
trust_dir=$ssh_dir/remote-dev-execution
known_hosts=$trust_dir/known_hosts
entry_tmp=$known_hosts.remote-dev-entry.$$
known_tmp=$known_hosts.tmp.$$
if [ -e "$entry_tmp" ] || [ -L "$entry_tmp" ] ||
  [ -e "$known_tmp" ] || [ -L "$known_tmp" ]; then
  printf "%s\n" "dev-relay: temporary VM trust path is occupied" >&2
  exit 69
fi
relay_host=__VM_ALIAS__
if [ -L "$trust_dir" ]; then
  printf "%s\n" "dev-relay: refusing to use a symlinked VM relay trust directory" >&2
  exit 78
fi
mkdir -p "$trust_dir"
chmod 0700 "$ssh_dir" "$trust_dir"
if [ -L "$known_hosts" ]; then
  printf "%s\n" "dev-relay: refusing to replace a symlinked VM known_hosts" >&2
  exit 78
fi
cat > "$entry_tmp"
: > "$known_tmp"
if [ -f "$known_hosts" ]; then
  while IFS= read -r known_line || [ -n "$known_line" ]; do
    case $known_line in
      "$relay_host "*) ;;
      *) printf "%s\n" "$known_line" >> "$known_tmp" ;;
    esac
  done < "$known_hosts"
fi
cat "$entry_tmp" >> "$known_tmp"
chmod 0600 "$known_tmp"
mv "$known_tmp" "$known_hosts"
rm -f "$entry_tmp"'
  remote_install_known_host=$(printf '%s\n' "$remote_install_known_host" | sed "s/__VM_ALIAS__/$vm_alias/g") ||
    return 1

  if ! outer_ssh_command "$remote_install_known_host" < "$vm_known_tmp"; then
    rm -f "$vm_config_tmp" "$vm_known_tmp"
    return 1
  fi
  rm -f "$vm_config_tmp" "$vm_known_tmp"
}

install_vm_wrapper() {
  remote_install_stat_helper='set -eu
umask 077
managed_dir=$HOME/.local/share/remote-dev-execution
helper=$managed_dir/portable-stat.sh
if [ -L "$managed_dir" ]; then
  printf "%s\n" "dev-relay: refusing to use a symlinked VM wrapper directory" >&2
  exit 78
fi
mkdir -p "$managed_dir"
if [ -L "$helper" ]; then
  printf "%s\n" "dev-relay: refusing to replace an invalid VM stat helper path: $helper" >&2
  exit 78
fi
if [ -e "$helper" ] && [ ! -f "$helper" ]; then
  printf "%s\n" "dev-relay: refusing to replace an invalid VM stat helper path: $helper" >&2
  exit 78
fi
helper_tmp=$helper.tmp.$$
if [ -e "$helper_tmp" ] || [ -L "$helper_tmp" ]; then
  printf "%s\n" "dev-relay: temporary VM stat helper path is occupied: $helper_tmp" >&2
  exit 69
fi
cat > "$helper_tmp"
chmod 0600 "$helper_tmp"
mv "$helper_tmp" "$helper"'

  remote_install_wrapper='set -eu
umask 077
managed_dir=$HOME/.local/share/remote-dev-execution
managed=$managed_dir/dev-exec
bin_dir=$HOME/.local/bin
link=$bin_dir/dev-exec
if [ -L "$managed_dir" ]; then
  printf "%s\n" "dev-relay: refusing to use a symlinked VM wrapper directory" >&2
  exit 78
fi
mkdir -p "$managed_dir" "$bin_dir"
if [ -L "$managed" ]; then
  printf "%s\n" "dev-relay: refusing to replace an invalid VM managed wrapper path: $managed" >&2
  exit 78
fi
if [ -e "$managed" ] && [ ! -f "$managed" ]; then
  printf "%s\n" "dev-relay: refusing to replace an invalid VM managed wrapper path: $managed" >&2
  exit 78
fi
managed_tmp=$managed.tmp.$$
if [ -e "$managed_tmp" ] || [ -L "$managed_tmp" ]; then
  printf "%s\n" "dev-relay: temporary VM wrapper path is occupied: $managed_tmp" >&2
  exit 69
fi
cat > "$managed_tmp"
chmod 0700 "$managed_tmp"
mv "$managed_tmp" "$managed"
if [ -L "$link" ]; then
  link_target=$(readlink "$link" || true)
  if [ "$link_target" != "$managed" ]; then
    printf "%s\n" "dev-relay: VM ~/.local/bin/dev-exec already points elsewhere; use $managed" >&2
  fi
elif [ -e "$link" ]; then
  printf "%s\n" "dev-relay: VM ~/.local/bin/dev-exec already exists; use $managed" >&2
else
  ln -s "$managed" "$link"
fi'

  outer_ssh_command "$remote_install_stat_helper" < "$script_dir/portable-stat.sh" || return 1
  outer_ssh_command "$remote_install_wrapper" < "$script_dir/dev-exec"
}

setup_cleanup() {
  if [ -n "${vm_public_tmp:-}" ]; then
    rm -f "$vm_public_tmp"
  fi
  if [ "${setup_started:-0}" -eq 1 ] && [ "${setup_complete:-0}" -eq 0 ]; then
    stop_relay >/dev/null 2>&1 || true
    if [ "${previous_sshd_running:-0}" -eq 1 ]; then
      start_sshd >/dev/null 2>&1 || true
    fi
    if [ "${previous_tunnel_running:-0}" -eq 1 ]; then
      start_tunnel >/dev/null 2>&1 || true
    fi
  fi
}

setup_relay() {
  setup_host_arg=
  project_requested=0
  project_vm_dir=
  project_mac_dir=
  project_shell=
  project_shell_set=0
  project_mutagen=
  project_mutagen_set=0
  project_mutagen_host=
  project_mutagen_host_set=0
  project_mutagen_bin=
  project_mutagen_bin_set=0
  project_clear_mutagen=0
  skill_client=
  skill_client_set=0
  skill_repo=$DEFAULT_SKILL_REPO
  skill_ref=$DEFAULT_SKILL_REF
  skill_repo_set=0
  skill_ref_set=0
  while [ "$#" -gt 0 ]; do
    case $1 in
      --project)
        [ "$project_requested" -eq 0 ] ||
          fail "$EX_USAGE" 'setup accepts only one --project mapping'
        [ "$#" -ge 3 ] ||
          fail "$EX_USAGE" '--project requires VM_PROJECT_DIR and MAC_PROJECT_DIR'
        project_requested=1
        project_vm_dir=$2
        project_mac_dir=$3
        shift 3
        ;;
      --shell)
        [ "$#" -ge 2 ] ||
          fail "$EX_USAGE" '--shell requires a shell path'
        project_shell=$2
        project_shell_set=1
        shift 2
        ;;
      --mutagen)
        [ "$#" -ge 2 ] ||
          fail "$EX_USAGE" '--mutagen requires a session name'
        project_mutagen=$2
        project_mutagen_set=1
        shift 2
        ;;
      --mutagen-host)
        [ "$#" -ge 2 ] ||
          fail "$EX_USAGE" '--mutagen-host requires an SSH alias'
        project_mutagen_host=$2
        project_mutagen_host_set=1
        shift 2
        ;;
      --mutagen-bin)
        [ "$#" -ge 2 ] ||
          fail "$EX_USAGE" '--mutagen-bin requires an executable name or path'
        project_mutagen_bin=$2
        project_mutagen_bin_set=1
        shift 2
        ;;
      --clear-mutagen)
        [ "$project_clear_mutagen" -eq 0 ] ||
          fail "$EX_USAGE" 'setup accepts only one --clear-mutagen option'
        project_clear_mutagen=1
        shift
        ;;
      --client)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--client requires a value'
        skill_client=$2
        skill_client_set=1
        shift 2
        ;;
      --repo)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--repo requires a value'
        skill_repo=$2
        skill_repo_set=1
        shift 2
        ;;
      --ref)
        [ "$#" -ge 2 ] || fail "$EX_USAGE" '--ref requires a value'
        skill_ref=$2
        skill_ref_set=1
        shift 2
        ;;
      --*)
        fail "$EX_USAGE" "unknown setup option: $1"
        ;;
      *)
        [ -z "$setup_host_arg" ] ||
          fail "$EX_USAGE" 'setup accepts at most one VM SSH alias'
        setup_host_arg=$1
        shift
        ;;
    esac
  done

  if [ -n "$setup_host_arg" ] && [ "$setup_host_arg" != "$vm_host" ]; then
    fail "$EX_CONFIG" "configuration uses VM host '$vm_host', not '$setup_host_arg'"
  fi
  if [ "$project_mutagen_set" -eq 1 ] && [ -z "$project_mutagen" ]; then
    fail "$EX_USAGE" '--mutagen requires a non-empty session name'
  fi
  if [ "$project_shell_set" -eq 1 ] && [ -z "$project_shell" ]; then
    fail "$EX_USAGE" '--shell requires a non-empty shell path'
  fi
  if [ "$skill_client_set" -eq 1 ] && [ -z "$skill_client" ]; then
    fail "$EX_USAGE" '--client requires a non-empty client name'
  fi
  if [ "$project_requested" -eq 0 ]; then
    if [ -n "$project_shell" ] || [ -n "$project_mutagen" ] ||
      [ -n "$project_mutagen_host" ] ||
      [ -n "$project_mutagen_bin" ] ||
      [ "$project_clear_mutagen" -eq 1 ]; then
      fail "$EX_USAGE" '--shell, --mutagen, --mutagen-host, --mutagen-bin, and --clear-mutagen require --project'
    fi
  fi
  if [ "$project_requested" -eq 1 ] && [ -z "$project_shell" ]; then
    project_shell=${SHELL:-}
  fi
  validate_project_request
  if [ -z "$skill_client" ]; then
    if [ "$skill_repo_set" -eq 1 ] || [ "$skill_ref_set" -eq 1 ]; then
      fail "$EX_USAGE" '--repo and --ref require --client during setup'
    fi
  else
    validate_skill_request
  fi

  setup_started=0
  setup_complete=0
  previous_sshd_running=0
  previous_tunnel_running=0
  vm_public_tmp=
  trap 'setup_cleanup' EXIT
  trap 'exit 129' HUP INT TERM

  vm_login_shell=$(outer_ssh_command 'printf "%s\n" "$SHELL"') ||
    fail "$EX_UNAVAILABLE" "cannot inspect the login shell on $vm_host"
  case ${vm_login_shell##*/} in
    sh|bash|zsh|dash|ksh) ;;
    *) fail "$EX_UNAVAILABLE" "VM login shell must be POSIX-compatible, got: $vm_login_shell" ;;
  esac

  say "checking passwordless SSH to $vm_host"
  outer_ssh_command true ||
    fail "$EX_UNAVAILABLE" "cannot connect non-interactively to $vm_host; run 'ssh $vm_host true' first"
  preflight_vm_project_config

  remote_prepare_key='set -eu
umask 077
ssh_dir=$HOME/.ssh
key=$ssh_dir/remote-dev-mac
mkdir -p "$ssh_dir"
chmod 0700 "$ssh_dir"
command -v ssh-keygen >/dev/null 2>&1 || {
  printf "%s\n" "dev-relay: ssh-keygen is unavailable on the VM" >&2
  exit 69
}
if [ -L "$key" ] || [ -L "$key.pub" ]; then
  printf "%s\n" "dev-relay: refusing to use a symlinked VM relay key" >&2
  exit 78
fi
if [ -e "$key" ] || [ -e "$key.pub" ]; then
  if [ ! -f "$key" ] || [ ! -f "$key.pub" ]; then
    printf "%s\n" "dev-relay: VM relay key pair is incomplete" >&2
    exit 78
  fi
else
  ssh-keygen -q -t ed25519 -N "" -f "$key" -C remote-dev-mac
fi
private_public_raw=$(ssh-keygen -y -f "$key") || {
  printf "%s\n" "dev-relay: VM relay private key is unreadable" >&2
  exit 78
}
private_public=$(printf "%s\n" "$private_public_raw" | awk "NR == 1 { print \$1 \" \" \$2 }")
stored_public=$(awk "NR == 1 { print \$1 \" \" \$2 }" "$key.pub")
  if [ "$private_public" != "$stored_public" ]; then
    printf "%s\n" "dev-relay: VM relay public key does not match its private key" >&2
    exit 78
  fi
case $private_public in
  ssh-ed25519\ *|sk-ssh-ed25519@openssh.com\ *) ;;
  *)
    printf "%s\n" "dev-relay: VM relay key must be Ed25519" >&2
    exit 78
    ;;
esac
chmod 0600 "$key"
chmod 0644 "$key.pub"'
  outer_ssh_command "$remote_prepare_key" ||
    fail "$EX_UNAVAILABLE" 'cannot prepare the dedicated VM relay key'

  ensure_state_dir
  vm_public_tmp=$state_dir/vm-public-key.tmp.$$
  refuse_temp_path "$vm_public_tmp"
  outer_ssh_command 'cat "$HOME/.ssh/remote-dev-mac.pub"' > "$vm_public_tmp" ||
    fail "$EX_UNAVAILABLE" 'cannot retrieve the VM relay public key'

  if [ -f "$authorized_keys" ] && ! cmp -s "$vm_public_tmp" "$authorized_keys"; then
    fail "$EX_CONFIG" "the VM relay key differs from $authorized_keys; use a distinct state directory or review the existing trust first"
  fi

  setup_started=1
  if [ -f "$sshd_config" ]; then
    if sshd_running; then
      previous_sshd_running=1
    fi
    if tunnel_running || recorded_tunnel_running; then
      previous_tunnel_running=1
    fi
    stop_tunnel || fail "$EX_UNAVAILABLE" 'cannot stop the existing reverse tunnel'
    stop_sshd || fail "$EX_UNAVAILABLE" 'cannot stop the existing user sshd'
  fi
  initialize_relay "$vm_public_tmp"
  rm -f "$vm_public_tmp"
  vm_public_tmp=
  start_relay

  if ! install_vm_access; then
    fail "$EX_UNAVAILABLE" 'cannot install the managed VM SSH configuration'
  fi
  if ! install_vm_wrapper; then
    fail "$EX_UNAVAILABLE" 'cannot install dev-exec on the VM'
  fi
  if ! install_vm_skill; then
    fail "$EX_UNAVAILABLE" 'cannot install the agent Skill in the VM'
  fi
  if ! write_vm_project_config; then
    fail "$EX_UNAVAILABLE" 'cannot configure the VM project'
  fi
  if ! outer_ssh_command "ssh -T -o BatchMode=yes -o StrictHostKeyChecking=yes -- $vm_alias true"; then
    fail "$EX_UNAVAILABLE" 'VM-to-Mac relay verification failed'
  fi

  setup_complete=1
  trap - EXIT HUP INT TERM
  say 'setup complete'
  say "VM command wrapper: ~/.local/share/remote-dev-execution/dev-exec"
  if [ "$project_requested" -eq 1 ]; then
    say "VM project config generated: $project_vm_dir/.dev-exec.env"
    if [ "$project_clear_mutagen" -eq 1 ]; then
      say 'Mutagen settings cleared; confirm a shared checkout or another blocking synchronization check before testing'
    elif [ -z "$project_mutagen" ]; then
      if [ -n "$skill_client" ]; then
        say 'VM separate-checkout setup: run ~/code/remote-dev-execution/scripts/setup-mutagen.sh --install --name SESSION from that project'
      else
        say 'source freshness is not configured; use a shared checkout, an existing session, or install the Skill and run setup-mutagen.sh'
      fi
    fi
    say 'VM next step: run ~/.local/share/remote-dev-execution/dev-exec doctor from that project'
  else
    say 'create .dev-exec.env in each VM project with the Mac project path, or rerun setup with --project'
  fi
  if [ -z "$skill_client" ]; then
    say 'VM agent Skill not requested; add --client claude, codex, or both to install it'
  else
    say 'restart the VM Agent session so it reloads the Skill'
  fi
}

start_relay() {
  [ "$#" -eq 0 ] || fail "$EX_USAGE" 'start does not accept arguments'
  ensure_initialized

  sshd_was_running=0
  if sshd_running; then
    sshd_was_running=1
  else
    start_sshd
  fi

  if ! start_tunnel; then
    if [ "$sshd_was_running" -eq 0 ]; then
      stop_sshd
    fi
    fail "$EX_UNAVAILABLE" "reverse tunnel failed; verify SSH access to $vm_host"
  fi

  say "ready: VM 127.0.0.1:$remote_port -> Mac 127.0.0.1:$local_port"
  if [ -n "$debug_ports" ]; then
    say "debug ports forwarded on VM loopback: $debug_ports"
  fi
}

foreground_cleanup() {
  stop_tunnel >/dev/null 2>&1 || true
  if [ "${foreground_started_sshd:-0}" -eq 1 ]; then
    stop_sshd >/dev/null 2>&1 || true
  fi
}

run_foreground() {
  [ "$#" -eq 0 ] || fail "$EX_USAGE" 'foreground does not accept arguments'
  ensure_initialized
  if tunnel_running || recorded_tunnel_running; then
    fail "$EX_UNAVAILABLE" 'a background tunnel is already running; stop it first'
  fi
  stop_recorded_tunnel ||
    fail "$EX_UNAVAILABLE" 'cannot clear the inactive recorded tunnel'

  foreground_started_sshd=0
  if ! sshd_running; then
    start_sshd
    foreground_started_sshd=1
  fi

  ensure_runtime_dir
  remove_stale_control_socket
  trap 'exit 129' HUP INT TERM
  trap 'foreground_cleanup' EXIT
  run_tunnel foreground
}

show_status() {
  [ "$#" -eq 0 ] || fail "$EX_USAGE" 'status does not accept arguments'
  relay_status=0

  if sshd_running; then
    say "user sshd: running on 127.0.0.1:$local_port"
  else
    say 'user sshd: stopped'
    relay_status=1
  fi

  if tunnel_running; then
    say "reverse tunnel: connected to $vm_host"
  elif recorded_tunnel_running; then
    say "reverse tunnel: connected to $recorded_host (recorded configuration)"
  else
    say 'reverse tunnel: stopped'
    relay_status=1
  fi

  say "log: $sshd_log"
  return "$relay_status"
}

stop_relay() {
  [ "$#" -eq 0 ] || fail "$EX_USAGE" 'stop does not accept arguments'
  stop_tunnel ||
    fail "$EX_UNAVAILABLE" 'cannot stop the reverse tunnel'
  stop_sshd
  say 'stopped'
}

print_vm_config() {
  [ "$#" -le 1 ] ||
    fail "$EX_USAGE" 'print-vm-config accepts at most one VM private-key path'
  ensure_initialized
  vm_identity='~/.ssh/remote-dev-mac'
  if [ "$#" -eq 1 ]; then
    vm_identity=$1
  fi
  case $vm_identity in
    *'
'*) fail "$EX_USAGE" 'VM private-key path must not contain a newline' ;;
  esac

  cat <<EOF
# Add to the VM's ~/.ssh/config:
$(vm_ssh_config "$vm_identity")

# Write this exact line to the VM's ~/.ssh/remote-dev-execution/known_hosts:
$(vm_known_host)
EOF
}

case $command_name in
  setup) setup_relay "$@" ;;
  install-skill) install_skill_command "$@" ;;
  init) initialize_relay "$@" ;;
  start) start_relay "$@" ;;
  foreground) run_foreground "$@" ;;
  status) show_status "$@" ;;
  stop) stop_relay "$@" ;;
  print-vm-config) print_vm_config "$@" ;;
esac
